#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/robots/adept/pioneer3/protos/Pioneer3dx.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/floors/protos/RectangleArena.proto"

WorldInfo {
  info [
    "AI Autonomous Agricultural Field Testing Arena",
    "SmartAg Research Station - Multi-Row Crop Disease Inspection & Precision Spraying"
  ]
  title "AI Agricultural Robot Testing Field"
  basicTimeStep 16
}

Viewpoint {
  orientation 0.288 0.258 -0.922 1.34
  position -2.8 9.5 8.2
  follow "Pioneer 3-DX"
  followSmoothness 0.2
}

TexturedBackground {
}

TexturedBackgroundLight {
}

DirectionalLight {
  direction 0.45 0.55 -0.70
  intensity 2.8
  castShadows TRUE
}

DirectionalLight {
  direction -0.40 -0.30 -0.60
  intensity 1.1
  castShadows FALSE
}

# ==============================================================================
# EXPANDED MAIN FIELD ARENA (22m x 15m)
# ==============================================================================
RectangleArena {
  translation 1.0 0.6 0
  floorSize 22 15
  floorAppearance PBRAppearance {
    baseColorMap ImageTexture {
      url [
        "../textures/soil.jpg"
      ]
    }
    roughness 0.95
    metalness 0
  }
  wallThickness 0.12
  wallHeight 0.35
  wallColor 0.28 0.16 0.08
}

# ==============================================================================
# ROBOT (Pioneer 3-DX with 3-DOF Manipulator & Camera End-Effector)
# ==============================================================================
Pioneer3dx {
  translation -2.05 0.095 0
  rotation 0 0 1 0
  controller "crop_robot_controller"
  extensionSlot [
    GPS {
      name "gps"
    }
    Compass {
      name "compass"
    }
    Solid {
      translation 0.05 0 0.18
      rotation 0 0 1 0
      name "manipulator_base"
      children [
        # Base Mounting Plate
        Shape {
          appearance PBRAppearance {
            baseColor 0.18 0.20 0.24
            roughness 0.4
            metalness 0.8
          }
          geometry Cylinder {
            height 0.03
            radius 0.07
          }
        }
        # Accent Trim Ring
        Transform {
          translation 0 0 0.015
          children [
            Shape {
              appearance PBRAppearance {
                baseColor 0.95 0.60 0.10
                roughness 0.3
                metalness 0.3
              }
              geometry Cylinder {
                height 0.008
                radius 0.072
              }
            }
          ]
        }
        # Joint 1: Base Rotation (Yaw around Z-axis)
        HingeJoint {
          jointParameters HingeJointParameters {
            axis 0 0 1
            anchor 0 0 0.03
            minStop -3.14159
            maxStop 3.14159
          }
          device [
            RotationalMotor {
              name "joint1_motor"
              maxVelocity 2.5
              maxTorque 30
            }
            PositionSensor {
              name "joint1_sensor"
            }
          ]
          endPoint Solid {
            translation 0 0 0.03
            rotation 0 0 1 0
            name "arm_link1"
            children [
              # Link 1: Turret Riser Body
              Transform {
                translation 0 0 0.03
                children [
                  Shape {
                    appearance PBRAppearance {
                      baseColor 0.22 0.24 0.28
                      roughness 0.5
                      metalness 0.7
                    }
                    geometry Cylinder {
                      height 0.06
                      radius 0.05
                    }
                  }
                ]
              }
              # Shoulder Pivot Mount Bracket
              Transform {
                translation 0 0 0.065
                children [
                  Shape {
                    appearance PBRAppearance {
                      baseColor 0.16 0.18 0.22
                      roughness 0.4
                      metalness 0.8
                    }
                    geometry Box {
                      size 0.065 0.075 0.05
                    }
                  }
                ]
              }
              # Joint 2: Shoulder Joint (Pitch around Y-axis)
              HingeJoint {
                jointParameters HingeJointParameters {
                  axis 0 1 0
                  anchor 0 0 0.07
                  minStop -2.2
                  maxStop 2.2
                }
                device [
                  RotationalMotor {
                    name "joint2_motor"
                    maxVelocity 2.5
                    maxTorque 30
                  }
                  PositionSensor {
                    name "joint2_sensor"
                  }
                ]
                endPoint Solid {
                  translation 0 0 0.07
                  rotation 0 1 0 0
                  name "arm_link2"
                  children [
                    # Shoulder Hub Pivot
                    Transform {
                      rotation 1 0 0 1.5708
                      children [
                        Shape {
                          appearance PBRAppearance {
                            baseColor 0.95 0.55 0.10
                            roughness 0.3
                            metalness 0.3
                          }
                          geometry Cylinder {
                            height 0.08
                            radius 0.032
                          }
                        }
                      ]
                    }
                    # Link 2: Upper Arm Boom
                    Transform {
                      translation 0 0 0.10
                      children [
                        Shape {
                          appearance PBRAppearance {
                            baseColor 0.88 0.50 0.08
                            roughness 0.4
                            metalness 0.3
                          }
                          geometry Cylinder {
                            height 0.18
                            radius 0.026
                          }
                        }
                      ]
                    }
                    # Joint 3: Elbow Joint (Pitch around Y-axis)
                    HingeJoint {
                      jointParameters HingeJointParameters {
                        axis 0 1 0
                        anchor 0 0 0.20
                        minStop -2.5
                        maxStop 2.5
                      }
                      device [
                        RotationalMotor {
                          name "joint3_motor"
                          maxVelocity 2.5
                          maxTorque 30
                        }
                        PositionSensor {
                          name "joint3_sensor"
                        }
                      ]
                      endPoint Solid {
                        translation 0 0 0.20
                        rotation 0 1 0 0
                        name "arm_link3_end_effector"
                        children [
                          # Elbow Pivot Hub
                          Transform {
                            rotation 1 0 0 1.5708
                            children [
                              Shape {
                                appearance PBRAppearance {
                                  baseColor 0.22 0.24 0.28
                                  roughness 0.4
                                  metalness 0.7
                                }
                                geometry Cylinder {
                                  height 0.065
                                  radius 0.028
                                }
                              }
                            ]
                          }
                          # Link 3: Forearm Boom
                          Transform {
                            translation 0 0 0.07
                            children [
                              Shape {
                                appearance PBRAppearance {
                                  baseColor 0.88 0.50 0.08
                                  roughness 0.4
                                  metalness 0.3
                                }
                                geometry Cylinder {
                                  height 0.12
                                  radius 0.020
                                }
                              }
                            ]
                          }
                          # End-Effector Tool Head / Camera Housing
                          Transform {
                            translation 0 0 0.14
                            children [
                              Shape {
                                appearance PBRAppearance {
                                  baseColor 0.12 0.14 0.16
                                  roughness 0.3
                                  metalness 0.9
                                }
                                geometry Box {
                                  size 0.045 0.055 0.035
                                }
                              }
                            ]
                          }
                          # Camera Optical Lens Bezel
                          Transform {
                            translation 0 0 0.16
                            children [
                              Shape {
                                appearance PBRAppearance {
                                  baseColor 0.05 0.05 0.05
                                  roughness 0.2
                                  metalness 0.95
                                }
                                geometry Cylinder {
                                  height 0.015
                                  radius 0.018
                                }
                              }
                            ]
                          }
                          # CAMERA (END-EFFECTOR SENSOR)
                          Camera {
                            translation 0 0 0.185
                            rotation 0 0 1 0
                            name "camera"
                            fieldOfView 0.9
                            width 128
                            height 128
                          }
                        ]
                        boundingObject Transform {
                          translation 0 0 0.07
                          children [
                            Box {
                              size 0.055 0.065 0.16
                            }
                          ]
                        }
                        physics Physics {
                          mass 0.18
                          centerOfMass [ 0 0 0.07 ]
                        }
                      }
                    }
                  ]
                  boundingObject Transform {
                    translation 0 0 0.10
                    children [
                      Box {
                        size 0.065 0.075 0.20
                      }
                    ]
                  }
                  physics Physics {
                    mass 0.30
                    centerOfMass [ 0 0 0.10 ]
                  }
                }
              }
            ]
            boundingObject Transform {
              translation 0 0 0.04
              children [
                Cylinder {
                  height 0.08
                  radius 0.05
                }
              ]
            }
            physics Physics {
              mass 0.35
              centerOfMass [ 0 0 0.04 ]
            }
          }
        }
      ]
      boundingObject Transform {
        translation 0 0 0.015
        children [
          Cylinder {
            height 0.03
            radius 0.07
          }
        ]
      }
      physics Physics {
        mass 0.40
        centerOfMass [ 0 0 0.015 ]
      }
    }
  ]
}

